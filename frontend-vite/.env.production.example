# SalesSync Frontend - Production Configuration for Cloudflare
# Copy this file to .env.production and update the values

# API Configuration - Cloudflare Workers API
VITE_API_BASE_URL=https://salessync-api.YOUR-SUBDOMAIN.workers.dev/api

# Application Configuration
VITE_APP_NAME=SalesSync
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG=false
